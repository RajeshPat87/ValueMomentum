# Secrets / local credentials — never commit
az-login.sh
**/az-login.sh
*.tfvars
!*.tfvars.example
# per-env Terraform flags, no secrets (like .bicepparam)
!kit/terraform/env/*.tfvars
.env
*.pem

# Terraform local state
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log

# Windows download metadata (WSL)
*:Zone.Identifier
*Zone.Identifier
